# Reproducible baseline train/eval image for PWM-LDCT v0.5 (manuscript Technical Validation).
# Build context is WS-1_dataset/ (so the sibling pwm_ldct_loader is in scope):
#   docker build -t pwm-ldct-baselines:v0.5 -f baselines/Dockerfile.baseline .
# Train then evaluate (GPU):
#   docker run --gpus all -v /data:/data -v $(pwd)/out:/out pwm-ldct-baselines:v0.5 \
#       train --dataset /data --out /out/red_cnn.pt --model red_cnn --epochs 100 --seed 42
#   docker run --gpus all -v /data:/data -v $(pwd)/out:/out pwm-ldct-baselines:v0.5 \
#       eval  --dataset /data --checkpoint /out/red_cnn.pt --split test --out /out/results.json --seed 42
FROM pytorch/pytorch:2.3.0-cuda12.1-cudnn8-runtime

WORKDIR /app
COPY pwm_ldct_loader /app/pwm_ldct_loader
COPY baselines /app/baselines
RUN pip install --no-cache-dir /app/pwm_ldct_loader \
    && pip install --no-cache-dir /app/baselines

ENTRYPOINT ["python", "-m", "pwm_ldct_baselines"]
CMD ["--help"]
