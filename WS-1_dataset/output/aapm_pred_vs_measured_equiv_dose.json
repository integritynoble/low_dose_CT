  "schema": "ws2-pred-vs-measured/ct-v1.1",
  "updated_at": "2026-08-22T12:14:51",
  "corpus": "AAPM 2016 LDCT grand challenge, held-out test (4 patients), FD vs official real QD (r=0.25)",
  "metric_definition": "Delta_r = |r_hat - r_star| / r_star (predicted_vs_measured_dose.md)",
  "protocol": {
    "physical_dose_response": "input-image SSIM/PSNR/ROI-BandER (no restoration) at r=0.10/0.25/0.50/1.0, shared 48-slice subset; r=0.10/0.50 lowdose_sim (seed 42), r=0.25 official real QD, r=1.0 FD",
    "equivalent_dose_channels": {
      "ssim": "monotone, r=1.0 anchor = 1.0; used for Delta_r mapping",
      "psnr": "monotone, no r=1.0 anchor (identity PSNR inf); curve 0.10..0.50, high end clamped at 0.50",
      "bander": "NOT usable as dose-response on physical inputs: low-dose noise adds broadband HF energy (BandER ~ 1 + HF_noise/HF_fd), curve is non-monotone. Kept as detectability CONTRAST channel: eps_bander = |BandER_pred - BandER_QD_phys| / BandER_QD_phys."
    },
    "r_star": "measured equivalent dose = QD acquisition performance mapped back through the physical curve (verified == 0.25 official)",
    "r_hat": "predicted equivalent dose = model restored-output performance on QD input (48-slice subset, reused from aapm_dose_detectability.json R4) mapped back through the same curve",
    "organization": "per volume (per patient per model); R3/R4 persisted only per-patient ROI BandER means",
    "extrapolation": "SSIM high end clamped at r=1.0; PSNR high end clamped at r=0.50; low end extrapolated down to 0.02"
  },
