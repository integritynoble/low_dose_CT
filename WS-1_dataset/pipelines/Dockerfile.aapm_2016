# Preprocessing image for AAPM 2016 Low-Dose CT Grand Challenge -> harmonized PWM-LDCT v0.5 HDF5.
# Build context is WS-1_dataset/:
#   docker build -t pwm-ldct-prep-aapm:v0.5 -f pipelines/Dockerfile.aapm_2016 .
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pwm_ldct_loader /app/pwm_ldct_loader
COPY pipelines/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt \
    && pip install --no-cache-dir /app/pwm_ldct_loader

COPY pipelines/pwm_ldct_prep /app/pwm_ldct_prep

ENV PWM_LDCT_SOURCE=aapm
ENTRYPOINT ["python", "-m", "pwm_ldct_prep"]
CMD ["--help"]
